# Port for the web interface
PORT=8080

# Pi-hole Configuration
# Set the number of Pi-holes you want to control
PIHOLE_COUNT=1

# Pi-hole 1
PIHOLE_1_NAME=Home
PIHOLE_1_URL=https://pi.hole
PIHOLE_1_PASSWORD=your-app-password

# Pi-hole 2 (Optional)
PIHOLE_2_NAME=Backup
PIHOLE_2_URL=https://backup.pi.hole
PIHOLE_2_PASSWORD=your-app-password

# Logging
LOG_FILE=/var/log/pihole-controller/access.log

# Notifications (ntfy)
NTFY_ENABLED=true
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=pihole-controller-secret-topic
